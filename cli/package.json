{
  "name": "@paulelian-tabarant/ripe",
  "version": "0.4.0",
  "type": "module",
  "license": "PolyFormNoncommercial-1.0.0",
  "bin": {
    "ripe": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome ci ./src ./tests",
    "lint:fix": "biome check --write ./src ./tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node dist/index.js --help",
    "ci:checks": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke",
    "cli": "pnpm run build && node dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@ripe/api": "workspace:*",
    "@types/node": "^26.6.4",
    "nock": "^14.0.17",
    "vitest": "^5.0.3"
  }
}