// Skill Usage Tracking — Architecture (C4 Model)
// Render: pnpm docs:c4
// Export: npx likec4 export png docs/architecture/ -o docs/architecture/export/
// VS Code: install the LikeC4 extension for live preview
//
// "Current" views show what is actually shipped in code today.
// "Target" views additionally show specced-but-unimplemented pieces (dashed, gray),
// tagged #planned. When a #planned piece ships, drop the tag/its exclude and it
// becomes part of "current" for free.

specification {
  tag planned

  element actor {
    style {
      shape person
    }
  }
  element system
  element container
  element database {
    style {
      shape storage
    }
  }
  element webapp {
    style {
      shape browser
    }
  }
  element script {
    style {
      shape component
    }
  }
}

model {
  developer = actor 'Developer' {
    description 'Uses Claude Code to write code'
  }

  viewer = actor 'Dashboard Viewer' {
    description 'Any team member checking skill usage - not necessarily someone coding with Claude Code'
  }

  browser = system 'Browser' {
    description 'Runs the downloaded SPA client-side, on the viewer machine'
  }

  claudeCode = system 'Claude Code CLI' {
    description 'Coding agent running on developer machine'
  }

  ripeCli = script 'ripe CLI' {
    description '`ripe init` registers the project (shipped). `ripe sync`, invoked by the SessionEnd hook, syncing skills and submitting invocation events, is specced but not yet implemented.'
  }

  localCache = database 'Local Cache' {
    description 'Local gitignored .ripe/config.json: { projectId, serverUrl }. Spec (US-1.3) calls for splitting this into settings.json (serverUrl) and cache.json (project_id, skill name -> ID cache, last_synced_sha) - not yet implemented.'
  }

  telemetryServer = system 'Telemetry Server' {
    description 'Fastify + SQLite, hosted on Railway'

    fastifyServer = container 'Fastify Server' {
      technology 'TypeScript, Node.js, Fastify'
      description 'Handles ingest and serves the dashboard API and SPA'
    }

    sqliteDb = database 'SQLite Database' {
      technology 'SQLite'
      description 'Railway volume-mounted path (DATABASE_PATH)'
    }

    reactSpa = webapp 'React SPA' {
      technology 'React, Vite, TypeScript'
      description 'Dashboard SPA bundle, built and served as a static artifact - executes in the Browser system, not on the server'
    }

    fastifyServer -> sqliteDb 'reads/writes'
    fastifyServer -> reactSpa 'serves static SPA bundle'
  }

  developer -> claudeCode 'uses'
  developer -> ripeCli 'runs `ripe init` once per project'
  claudeCode -> ripeCli 'SessionEnd hook invokes `ripe sync`' {
    #planned
  }
  ripeCli -> localCache 'reads/writes cached state'
  ripeCli -> telemetryServer.fastifyServer 'POST /api/projects { name, remoteUrl } (find-or-create; repo_key derived server-side from remoteUrl)' {
    technology 'HTTP/JSON'
  }
  ripeCli -> telemetryServer.fastifyServer 'POST /api/skills' {
    #planned
    technology 'HTTP/JSON'
  }
  ripeCli -> telemetryServer.fastifyServer 'POST /api/events' {
    #planned
    technology 'HTTP/JSON'
  }
  viewer -> browser 'opens the dashboard URL'
  browser -> telemetryServer.fastifyServer 'GET / (downloads SPA bundle)' {
    technology 'HTTPS'
  }
  browser -> telemetryServer.fastifyServer 'GET /api/projects' {
    technology 'HTTP/JSON'
  }
  browser -> telemetryServer.fastifyServer 'GET /api/projects/{id}/activity' {
    #planned
    technology 'HTTP/JSON'
  }
}

views {
  view contextCurrent {
    title 'System Context — Current (C4 Level 1)'
    include developer, viewer, browser, claudeCode, ripeCli, localCache, telemetryServer
    exclude * -> * where tag is #planned
  }

  view contextTarget {
    title 'System Context — Target (C4 Level 1)'
    include developer, viewer, browser, claudeCode, ripeCli, localCache, telemetryServer
    include * -> * where tag is #planned with {
      line dashed
      color gray
    }
  }

  view containersCurrent of telemetryServer {
    title 'Container View — Current (C4 Level 2)'
    include developer, viewer, browser, claudeCode, ripeCli, localCache, *
    exclude * -> * where tag is #planned
  }

  view containersTarget of telemetryServer {
    title 'Container View — Target (C4 Level 2)'
    include developer, viewer, browser, claudeCode, ripeCli, localCache, *
    include * -> * where tag is #planned with {
      line dashed
      color gray
    }
  }

  dynamic view initFlow {
    title '`ripe init` — Project Registration (shipped)'

    developer -> ripeCli 'runs `ripe init` (prints consent notice, derives remote URL from `git remote get-url origin`)'
    ripeCli -> telemetryServer.fastifyServer 'POST /api/projects { name, remoteUrl }'
    ripeCli <- telemetryServer.fastifyServer 'returns project_id (idempotent find-or-create; repo_key derived server-side)'
    ripeCli -> localCache 'writes .ripe/config.json { projectId, serverUrl }'
  }

  dynamic view sessionEndFlow {
    title '`ripe sync` (SessionEnd Hook) — Two-Phase Flow (planned, not yet implemented)'

    claudeCode -> ripeCli 'SessionEnd: invokes `ripe sync`'
    ripeCli -> localCache 'reads cached project_id (or re-resolves via repo_key if missing)'

    // Phase 1: Skill sync
    ripeCli -> localCache 'reads cached skill IDs'
    ripeCli -> telemetryServer.fastifyServer 'POST /api/skills (unregistered skills only)'
    ripeCli <- telemetryServer.fastifyServer 'returns server-assigned IDs'
    ripeCli -> localCache 'persists new skill IDs'

    // Phase 2: Event submission
    ripeCli -> telemetryServer.fastifyServer 'POST /api/events (session invocations; user.email/user.name read live, not cached; client_type: "claude-code")'
  }

  dynamic view dashboardViewFlow {
    title 'Viewing the Dashboard (project list shipped; activity drill-down planned)'

    viewer -> browser 'opens the dashboard URL'
    browser -> telemetryServer.fastifyServer 'GET / (downloads SPA bundle)'
    browser -> telemetryServer.fastifyServer 'GET /api/projects'
    viewer -> browser 'selects a project'
    browser -> telemetryServer.fastifyServer 'GET /api/projects/{id}/activity (planned)'
  }
}
