{
  "name": "ripe",
  "version": "0.1.0",
  "description": "An eye on how your coding agent uses your context (or not)",
  "engines": {
    "node": "24.18.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter api run start:local & pnpm --filter web run dev & wait",
    "docs:c4": "likec4 start docs/architecture/",
    "docs:c4:validate": "likec4 validate docs/architecture/",
    "docs:c4:build": "likec4 build docs/architecture/ -o dist-docs --base /ripe/ -t 'ripe — Architecture'",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\""
  },
  "packageManager": "pnpm@11.13.1",
  "license": "PolyFormNoncommercial-1.0.0",
  "devDependencies": {
    "likec4": "latest",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
